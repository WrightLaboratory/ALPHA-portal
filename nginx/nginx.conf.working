events {

}

http {
  client_max_body_size 200m;

  server {
    listen 80;
    listen [::]:80;

    server_name whoami.alphadm.wlab.yale.edu auth.alphadm.wlab.yale.edu alphadm.wlab.yale.edu;

    return 301 https://$server_name$request_uri;
  }

  server {
    server_name alphadm.wlab.yale.edu;

    listen 443 ssl;
    listen [::]:443 ssl;

    resolver 127.0.0.11 valid=30s;

    # SSL
    ssl_certificate /etc/letsencrypt/archive/certs/cert.pem;
    ssl_certificate_key /etc/letsencrypt/archive/certs/key.pem;

    location / {
      return 200 "hello world!";
    }
  }

  server {
    server_name auth.alphadm.wlab.yale.edu;

    listen 443 ssl;
    listen [::]:443 ssl;

    resolver 127.0.0.11 valid=30s;

    set $upstream http://authelia-server:9091;

    # SSL
    ssl_certificate /etc/letsencrypt/archive/certs/cert.pem;
    ssl_certificate_key /etc/letsencrypt/archive/certs/key.pem;

    location / {
      include /etc/nginx/proxy.conf;
      proxy_pass $upstream;
    }

    location = /api/verify {
      proxy_pass $upstream;
    }

    location /api/authz/ {
      proxy_pass $upstream;
    }

  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name whoami.alphadm.wlab.yale.edu;
    
    resolver 127.0.0.11 valid=30s;

    # SSL
    ssl_certificate /etc/letsencrypt/archive/certs/cert.pem;
    ssl_certificate_key /etc/letsencrypt/archive/certs/key.pem;

    include /etc/nginx/authelia-location.conf;

    set $upstream http://whoami:80;

    location / {
      include /etc/nginx/proxy.conf;
      include /etc/nginx/authelia-authrequest.conf;
      proxy_pass $upstream;
    }
  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name lldap.alphadm.wlab.yale.edu;
    
    resolver 127.0.0.11 valid=30s;

    # SSL
    ssl_certificate /etc/letsencrypt/archive/certs/cert.pem;
    ssl_certificate_key /etc/letsencrypt/archive/certs/key.pem;

    include /etc/nginx/authelia-location.conf;

    set $upstream http://lldap:17170;

    location / {
      include /etc/nginx/proxy.conf;
      include /etc/nginx/authelia-authrequest.conf;
      proxy_pass $upstream;
    }
  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name homer.alphadm.wlab.yale.edu;
    
    resolver 127.0.0.11 valid=30s;

    # SSL
    ssl_certificate /etc/letsencrypt/archive/certs/cert.pem;
    ssl_certificate_key /etc/letsencrypt/archive/certs/key.pem;

    include /etc/nginx/authelia-location.conf;

    set $upstream http://homer:8080;

    location / {
      include /etc/nginx/proxy.conf;
      include /etc/nginx/authelia-authrequest.conf;
      proxy_pass $upstream;
    }
  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name grafana.alphadm.wlab.yale.edu;
    
    resolver 127.0.0.11 valid=30s;

    # SSL
    ssl_certificate /etc/letsencrypt/archive/certs/cert.pem;
    ssl_certificate_key /etc/letsencrypt/archive/certs/key.pem;

    include /etc/nginx/authelia-location.conf;

    set $upstream http://grafana:3000;

    location / {
      include /etc/nginx/proxy.conf;
      include /etc/nginx/authelia-authrequest.conf;
      proxy_pass $upstream;
    }
  }

}